{
  "name": "@saurabhmisal/power-chords",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "exports": {
    "./judgement": "./knowledge/product-judgement/index.cjs",
    "./*": "./*"
  },
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "node --test test/*.test.mjs workflows/reel-to-knowledge/test.mjs",
    "test:judgement": "node --test test/judgement.test.mjs",
    "export:judgement": "node scripts/export-judgement.mjs",
    "smoke": "node src/smoke.mjs",
    "inspect:all": "node src/inspect-all.mjs",
    "install:reviewed": "node src/install-reviewed.mjs",
    "sync:upstreams": "node scripts/sync-sources.mjs",
    "validate:catalog": "node scripts/validate-catalog.mjs",
    "build:site": "node scripts/build-site.mjs",
    "render:updates": "node scripts/render-changelog.mjs",
    "keepalive": "node scripts/keepalive.mjs",
    "demo": "node src/demo.mjs",
    "capabilities:list": "node scripts/capabilities-cli.mjs list",
    "capabilities:install": "node scripts/capabilities-cli.mjs install",
    "capabilities:docs": "node scripts/generate-capability-docs.mjs",
    "validate:capabilities": "node scripts/validate-capabilities.mjs",
    "setup:runtime": "node scripts/setup-runtime.mjs",
    "preview:runtime": "node src/runtime/server.mjs",
    "verify:runtime": "node scripts/verify-runtime.mjs",
    "knowledge:ingest": "node workflows/reel-to-knowledge/cli.mjs ingest",
    "knowledge:search": "node workflows/reel-to-knowledge/cli.mjs search",
    "knowledge:list": "node workflows/reel-to-knowledge/cli.mjs list",
    "knowledge:note": "node workflows/reel-to-knowledge/cli.mjs note",
    "knowledge:install": "node workflows/reel-to-knowledge/install.mjs",
    "knowledge:mcp": "node workflows/reel-to-knowledge/mcp.mjs",
    "test:reel-knowledge": "node --test workflows/reel-to-knowledge/test.mjs"
  },
  "author": "Saurabh Misal (https://github.com/saurabhmisal)",
  "license": "MIT",
  "description": "Power Chords: portable agent skills and a private Codex workspace for product builders",
  "repository": {
    "type": "git",
    "url": "https://github.com/saurabhmisal/power-chords.git"
  }
}
